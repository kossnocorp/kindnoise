<Window
    x:Class="KindNoise.LaunchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:KindNoise"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Padding="32"
            Orientation="Vertical"
            Spacing="18"
            VerticalAlignment="Center">
            <StackPanel Orientation="Vertical" Spacing="16">

                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16">
                    <Image Height="32" Source="/Assets/icon.png" />

                    <TextBlock FontSize="32" TextWrapping="WrapWholeWords">
                        Welcome to Kind Noise!
                    </TextBlock>
                </StackPanel>

                <TextBlock FontSize="16" TextWrapping="WrapWholeWords">
                    The app lives in your tray. Click left mouse button to play/pause and right button to switch sounds.
                </TextBlock>

                <RichTextBlock FontSize="16">
                    <Paragraph>
                        If you have any feedback, please <Hyperlink NavigateUri="https://kindnoise.com/feedback">let me know</Hyperlink>.
                    </Paragraph>
                </RichTextBlock>

                <TextBlock FontSize="18" TextWrapping="WrapWholeWords" />
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="launchCheckbox">Show this window on launch</CheckBox>
            </StackPanel>
        </StackPanel>

        <Image Grid.Column="1" Source="/Assets/screenshot.png" />
    </Grid>
</Window>
