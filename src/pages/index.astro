---
import Layout from "../layouts/Layout.astro";
import Logotype from "../components/Logotype.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Kind Noise">
  <div class="p-10 grid place-items-center">
    <div class="flex w-full max-w-4xl bg-gray-800 rounded-lg">
      <main class="p-10 flex flex-col space-y-12">
        <div class="flex flex-col space-y-6">
          <Logotype size="large" />

          <p class="text-xl">
            Kind Noise is a free tiny app that lives in your tray and plays a
            brownish noise to help you focus on work or study.
          </p>
        </div>

        <div class="flex flex-col space-y-6">
          <div>
            <a
              href="https://firebasestorage.googleapis.com/v0/b/kind-noise.appspot.com/o/downloads%2Fwindows.zip?alt=media&token=e7335169-cd10-4a89-b9cb-8a9d4d86862b"
              class="rounded-full bg-blue-600 hover:bg-blue-500 text-xl p-3 px-10"
            >
              Download for Windows
            </a>
          </div>
        </div>
        
        <Footer />
      </main>

      <img src="/screenshot.png" />
    </div>
  </div>
</Layout>
