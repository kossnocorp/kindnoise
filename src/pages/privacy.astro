---
import Layout from "../layouts/Layout.astro";
import Logotype from "../components/Logotype.astro";
---

<Layout title="Feedback on Kind Noise">
  <div class="p-10 grid place-items-center">
    <div class="flex w-full max-w-4xl bg-gray-800 rounded-lg">
      <main class="p-10 flex flex-col space-y-12">
        <div class="flex flex-col space-y-6">
          <Logotype />

          <div class="prose prose-lg prose-invert">
            <h1>Privacy policy</h1>

              <p>
                The desktop app Kind Noise (the "App") does not collect or store
                any personal information.
              </p>

              <p>
                However, anonymous usage data might be collected to help improve the App. This
data can include
              </p>
              
              <ul>
                <li>The App version number</li>
                <li>System information such as operating system version, CPU architecture, and memory</li>
                <li>Usage data such as the number of times the App is launched and the number of times a feature is used</li>
              </ul>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layout>